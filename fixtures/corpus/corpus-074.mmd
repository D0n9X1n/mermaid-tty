flowchart TD
    subgraph Backend
        api["API gateway<br/>Kong"]
        subgraph svc ["Services"]
            user["User service"]
            order["Order service"]
            payment["Payment service"]
        end
    end
    subgraph data ["Storage"]
        mysql[("MySQL")]
        redis[("Redis")]
    end
    browser("Browser") -- HTTPS --> api
    api --> user
    api --> order
    api --> payment
    user --> redis
    order --> mysql
    payment --> mysql
    payment -.->|payment events| kafka["Kafka"]
